# Copy this file to .env and fill in real values for local development.
# On Netlify / Vercel, set these in the project's Environment Variables settings instead.

# Client-side (Vite) — safe to expose, this is the public key
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side (SSR / server functions)
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
